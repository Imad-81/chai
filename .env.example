# Telegram Bot Configuration (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Optional: restrict bot to your Telegram user ID (from @userinfobot)
TELEGRAM_ALLOWED_USERS=

# Network Ports (for legacy/archived bridge or diagnostics)
BRIDGE_PORT=5056
PYTHON_WEBHOOK_PORT=5055

# Ollama & Dispatcher Model
OLLAMA_HOST=http://127.0.0.1:11434
DISPATCHER_MODEL=gemma4:12b

# Whisper Voice Transcription
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu

# Antigravity CLI & Projects
AGY_BINARY=/home/imad/.local/bin/agy
AGY_SPAWN_TERMINAL=true
AGY_TERMINAL_EMULATOR=gnome-terminal
AGY_UI_MODE=interactive
PROJECTS_ROOT=/home/imad/projects

# Allowed phone numbers (optional extra restriction; e.g. 917032866208)
ALLOWED_PHONE_NUMBERS=
