# Telegram Bot Configuration (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Optional: restrict bot to your Telegram user ID (from @userinfobot)
TELEGRAM_ALLOWED_USERS=

# Network Ports (for legacy/archived bridge or diagnostics)
BRIDGE_PORT=5056
PYTHON_WEBHOOK_PORT=5055

# Ollama & Models
OLLAMA_HOST=http://127.0.0.1:11434
DISPATCHER_MODEL=qwen3.5:4b
MEMORY_RESOLVER_MODEL=qwen3.5:4b
TASK_SYNTHESIZER_MODEL=qwen3.5:4b
MEMORY_SESSION_TIMEOUT_MINUTES=30
MEMORY_AUTO_SUMMARIZE=true

# Whisper Voice Transcription
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu

# Antigravity CLI & Projects
# Left blank to automatically discover `agy` in PATH or home directories
AGY_BINARY=
AGY_SPAWN_TERMINAL=false
AGY_TERMINAL_EMULATOR=
AGY_UI_MODE=print
# Projects root directory (defaults to ~/projects cross-platform if blank)
PROJECTS_ROOT=

# Allowed phone numbers (optional extra restriction; e.g. 917032866208)
ALLOWED_PHONE_NUMBERS=
